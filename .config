[Hotkey]
Key = Super_L
KeyShortcut = Control_L+Super_L+Z

[Hotkey]
Key = XF86MonBrightnessDown
KeyCommand = xakar.action(brightness -10%)

[Hotkey]
Key = XF86MonBrightnessUp
KeyCommand = xakar.action(brightness +10%)

[Hotkey]
Key = Super_L+Up
KeyCommand = xakar.action(tile up)

[Hotkey]
Key = Super_L+Down
KeyCommand = xakar.action(tile down)

[Hotkey]
Key = Super_L+Left
KeyCommand = xakar.action(tile left)

[Hotkey]
Key = Super_L+Right
KeyCommand = xakar.action(tile right)

[Hotkey]
Key = Super_L+Return
KeyCommand = xakar.action(tile center)

[Hotkey]
Key = Super_L+space
KeyCommand = xakar.action(tile fullscreen)

[Hotkey]
Key = Super_L+Shift_L+space
KeyCommand = xakar.action(tile wm_fullscreen)

[Hotkey]
Key = Super_L+Alt_L+Up
KeyCommand = xakar.action(tile up preserve_geom)

[Hotkey]
Key = Super_L+Alt_L+Down
KeyCommand = xakar.action(tile down preserve_geom)

[Hotkey]
Key = Super_L+Alt_L+Left
KeyCommand = xakar.action(tile left preserve_geom)

[Hotkey]
Key = Super_L+Alt_L+Right
KeyCommand = xakar.action(tile right preserve_geom)

[Hotkey]
Key = Super_L+Alt_L+Return
KeyCommand = xakar.action(tile center preserve_geom)

[Hotkey]
Key = Super_L+Alt_L+space
KeyCommand = xakar.action(tile fullscreen preserve_geom)

[Hotkey]
Key = Super_L+Alt_L+Shift_L+space
KeyCommand = xakar.action(tile wm_fullscreen preserve_geom)

[Hotkey]
Key = Super_L+Control_L+Up
KeyCommand = xakar.action(tile up preserve_mode)

[Hotkey]
Key = Super_L+Control_L+Down
KeyCommand = xakar.action(tile down preserve_mode)

[Hotkey]
Key = Super_L+Control_L+Left
KeyCommand = xakar.action(tile left preserve_mode)

[Hotkey]
Key = Super_L+Control_L+Right
KeyCommand = xakar.action(tile right preserve_mode)

[Hotkey]
Key = Super_L+Control_L+Return
KeyCommand = xakar.action(tile center preserve_mode)

[Hotkey]
Key = Super_L+Control_L+space
KeyCommand = xakar.action(tile fullscreen preserve_mode)

[Hotkey]
Key = Super_L+Control_L+Shift_L
KeyCommand = xakar.action(tile wm_fullscreen preserve_mode)

[Some other Feature]
Key = Super_L+Right
KeySS = meowmeowmeow

