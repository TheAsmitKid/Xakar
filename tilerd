#!/usr/bin/env python3

import os
import re
import select
import subprocess

FIFO_PATH = os.path.expanduser("~/.tiler.sock")

def move_resize(window_id, x, y, width, height):
    subprocess.run(['xdotool', 'windowmove', window_id, str(x), str(y)])
    subprocess.run(['xdotool', 'windowsize', window_id, str(width), str(height)])

def get_geometry():
    active_id = subprocess.run(['xdotool', 'getactivewindow'], capture_output=True, text=True).stdout.strip()
    active_hex = f"0x{int(active_id):x}"

    wininfo = subprocess.check_output(["xwininfo", "-root", "-tree"]).decode().splitlines()

    geom_pattern = re.compile(r'(\d+)x(\d+)\+(\d+)\+(\d+)')
    top_level_pattern = re.compile(r'^ {5}(?! )')

    current_block = []
    for line in wininfo:
        line = line.rstrip()
        if top_level_pattern.match(line):
            if current_block and any(active_hex in l for l in current_block):
                for subline in current_block:
                    if active_hex in subline:
                        geom_match = geom_pattern.search(subline)
                        if geom_match:
                            width, height, x, y = (int(n) for n in geom_match.groups())
                            break
                break
            current_block = [line]
            geom_match = geom_pattern.search(line)
            if geom_match:
                ancestor_width, ancestor_height, ancestor_x, ancestor_y = (int(n) for n in geom_match.groups())
        else:
            current_block.append(line)

    return {
        "active_hex": active_hex,
        "width": width, "height": height,
        "ancestor_x": ancestor_x, "ancestor_y": ancestor_y,
        "ancestor_width": ancestor_width, "ancestor_height": ancestor_height,
    }

def get_screen_dims():
    dimensions = subprocess.run(['xdpyinfo'], capture_output=True, text=True).stdout
    match = re.search(r'dimensions:\s+(\d+)x(\d+)', dimensions)
    if match:
        screen_width, screen_height = int(match[1]), int(match[2])
        return screen_width, screen_height
    raise RuntimeError("Could not parse screen dimensions")

def handle_action(action, screen_width, screen_height, half_screen_width, half_screen_height):
    if action not in {'center', 'fullscreen', 'left', 'right', 'up', 'down'}:
        return

    geom = get_geometry()

    overhead_x = geom["ancestor_width"] - geom["width"]
    overhead_y = geom["ancestor_height"] - geom["height"]

    full_width = screen_width - overhead_x
    full_height = screen_height - overhead_y
    half_width = half_screen_width - overhead_x
    half_height = half_screen_height - overhead_y

    x_new = y_new = w_new = h_new = 0

    if (geom["ancestor_width"] == screen_width and geom["ancestor_height"] == screen_height and action != 'fullscreen'):
        subprocess.run(['wmctrl', '-r', ':ACTIVE:', '-b', 'remove,maximized_vert,maximized_horz'])

    if action == 'center':
        w_new, h_new = int(0.75 * screen_width), int(0.75 * screen_height)
        x_new = (screen_width - w_new - overhead_x) // 2
        y_new = (screen_height - h_new -overhead_y) // 2

    elif action == 'fullscreen':
        x_new, y_new = 0, 0
        w_new, h_new = full_width, full_height

    elif action in {'left', 'right'}:
        x_new = 0 if action == 'left' else half_screen_width
        w_new = half_width
        if geom["width"] <= half_width and geom["ancestor_x"] == x_new and geom["height"] <= half_height or geom["height"] == full_height:
            y_new = 0
            h_new = full_height
        else:
            y_new = 0 if geom["ancestor_y"] < half_screen_height else half_screen_height
            h_new = half_height

    elif action in {'up', 'down'}:
        y_new = 0 if action == 'up' else half_screen_height
        h_new = half_height
        if geom["height"] <= half_height and geom["ancestor_y"] == y_new and geom["width"] >= half_width or geom["width"] == full_width:
            x_new = 0
            w_new = full_width
        else:
            x_new = 0 if geom["ancestor_x"] < half_screen_width else half_screen_width
            w_new = half_width

    move_resize(geom["active_hex"], x_new, y_new, w_new, h_new)

def main():
    if os.path.exists(FIFO_PATH):
        os.remove(FIFO_PATH)
    os.mkfifo(FIFO_PATH)
    
    screen_width, screen_height = get_screen_dims()
    half_screen_width = screen_width // 2
    half_screen_height = screen_height // 2
    
    print(f"[tilerd] Listening on {FIFO_PATH}...")

    while True:
        with open(FIFO_PATH, "r") as fifo:
            ready, _, _ = select.select([fifo], [], [], 1)
            if ready:
                line = fifo.readline().strip()
                if line:
                    handle_action(line, screen_width, screen_height, half_screen_width, half_screen_height)

if __name__ == "__main__":
    main()